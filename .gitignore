# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
.next/
out/

# Environment files — NEVER commit secrets
.env
.env.local
.env.*.local
.env.production

# Prisma generated client (generated at build/deploy time)
backend/node_modules/.prisma/

# Uploads (user data — stored on server/S3, not in git)
uploads/
*.upload

# Patches / local snapshots (not source — never commit)
*.patch

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo

# Docker
.dockerignore

# TypeScript
*.tsbuildinfo

# Test coverage
coverage/
.nyc_output/

# Certificates
nginx/certs/
*.pem
*.key
*.crt
