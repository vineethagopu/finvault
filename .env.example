# ─────────────────────────────────────────────────────────────────────────────
# PolicyNext — single source of truth for configuration.
#
# Copy to `.env` at the repo root:  cp .env.example .env   (NEVER commit .env)
# Docker Compose auto-loads this root .env and injects the right vars into every
# service (see docker-compose.yml / docker-compose.override.yml). You do NOT
# need per-app .env files when running via Docker.
#
# Running the backend standalone (no Docker)? Also set DATABASE_URL / REDIS_URL
# below and export them (or copy this into backend/.env).
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=policynext
POSTGRES_USER=policynext
POSTGRES_PASSWORD=change_me_strong_password
# Standalone backend only (Docker builds this from the vars above):
# DATABASE_URL="postgresql://policynext:change_me_strong_password@localhost:5432/policynext?schema=public"

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=generate_64_random_bytes_hex
JWT_REFRESH_SECRET=generate_another_64_random_bytes_hex
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Comma-separated list — allow the deployed SPA origin plus any preview URLs.
CORS_ORIGIN=http://localhost:5173
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=generate_32_random_bytes_hex

# Set to `none` ONLY when the SPA and the API are on different sites (e.g. app
# on Cloudflare Pages, API on Render). Browsers drop SameSite=Lax cookies on
# cross-site requests, which breaks login, every authed call and the SSE stream.
# `none` forces Secure, so it requires HTTPS on both ends. Leave as `lax` for
# same-origin setups (local dev, the Compose stack behind one NGINX).
COOKIE_SAMESITE=lax
# Set to `false` only if the API is NOT behind a TLS-terminating proxy.
# TRUST_PROXY=true

# ── Object storage (optional — falls back to local disk if unset) ─────────────
# S3-compatible: Cloudflare R2, AWS S3, Backblaze B2, MinIO.
# REQUIRED on hosts with an ephemeral filesystem (Render free tier), otherwise
# every uploaded document and avatar is lost on restart/redeploy.
# For R2: endpoint is https://<account-id>.r2.cloudflarestorage.com, region 'auto'.
# S3_BUCKET=policynext-documents
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_REGION=auto

# ── Email / SMTP (OTP + notifications) ────────────────────────────────────────
# Leave SMTP_HOST empty to auto-use an Ethereal test inbox (logs a preview URL).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PolicyNext <noreply@policynext.com>

# ── SMS / Twilio (OTP) ────────────────────────────────────────────────────────
# Leave empty to log SMS to the console and echo the OTP back in dev.
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Browser-facing API base. Under Docker this is injected by compose; for local
# `npm run dev` the Vite proxy handles /api, so it can stay unset.
VITE_API_URL=http://localhost:3000/api/v1
