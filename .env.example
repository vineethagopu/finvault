# Copy this file to .env and fill in values
# NEVER commit .env to git

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=policynext
POSTGRES_USER=policynext
POSTGRES_PASSWORD=change_me_strong_password

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_password

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=generate_64_random_bytes_hex
JWT_REFRESH_SECRET=generate_another_64_random_bytes_hex
JWT_ACCESS_EXPIRES_IN=15m

# ── App ───────────────────────────────────────────────────────────────────────
CORS_ORIGIN=https://yourdomain.com
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=generate_32_random_bytes_hex

# ── AWS S3 (optional — uses local storage if not set) ─────────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=policynext-documents

# ── Email (for OTP delivery) ──────────────────────────────────────────────────
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_api_key
# SMTP_FROM=noreply@policynext.in

# ── SMS (for OTP delivery) ────────────────────────────────────────────────────
# TWILIO_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1234567890
