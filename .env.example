# ─────────────────────────────────────────────────────────────────────────────
# PolicyNext — single source of truth for configuration.
#
# Copy to `.env` at the repo root:  cp .env.example .env   (NEVER commit .env)
# Docker Compose auto-loads this root .env and injects the right vars into every
# service (see docker-compose.yml / docker-compose.override.yml). You do NOT
# need per-app .env files when running via Docker.
#
# Running the backend standalone (no Docker)? Also set DATABASE_URL / REDIS_URL
# below and export them (or copy this into backend/.env).
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=policynext
POSTGRES_USER=policynext
POSTGRES_PASSWORD=change_me_strong_password
# Standalone backend only (Docker builds this from the vars above):
# DATABASE_URL="postgresql://policynext:change_me_strong_password@localhost:5432/policynext?schema=public"

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_password
# Standalone backend only (Docker builds this automatically):
# REDIS_URL="redis://:change_me_redis_password@localhost:6379"

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=generate_64_random_bytes_hex
JWT_REFRESH_SECRET=generate_another_64_random_bytes_hex
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=generate_32_random_bytes_hex

# ── AWS S3 (optional — uses local disk storage if not set) ────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=policynext-documents

# ── Email / SMTP (OTP + notifications) ────────────────────────────────────────
# Leave SMTP_HOST empty to auto-use an Ethereal test inbox (logs a preview URL).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PolicyNext <noreply@policynext.com>

# ── SMS / Twilio (OTP) ────────────────────────────────────────────────────────
# Leave empty to log SMS to the console and echo the OTP back in dev.
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Browser-facing API base. Under Docker this is injected by compose; for local
# `npm run dev` the Vite proxy handles /api, so it can stay unset.
VITE_API_URL=http://localhost:3000/api/v1
