# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/policynext"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# App
NODE_ENV="development"
PORT=3000
CORS_ORIGIN="http://localhost:5173"

# AWS S3
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_S3_BUCKET="policynext-documents"

# Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your@email.com"
SMTP_PASS="your-app-password"
SMTP_FROM="PolicyNext <noreply@policynext.com>"

# SMS (Twilio / AWS SNS)
SMS_PROVIDER="console"   # "console" | "twilio" | "sns"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Encryption
ENCRYPTION_KEY="32-char-hex-encryption-key-here!!"

# CSRF
CSRF_SECRET="change-me-csrf-secret"
